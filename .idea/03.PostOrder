//https://www.geeksforgeeks.org/batch/dsa-at-your-own-pace/track/DSASP-Tree/problem/postorder-traversal

class Solution {
    public ArrayList<Integer> postOrder(Node root) {
        ArrayList<Integer> q=new ArrayList<>();
        if(root==null){
            return q;
        }
        q.addAll(postOrder(root.left));
        q.addAll(postOrder(root.right));
        q.add(root.data);
        return q;
        
    }
}

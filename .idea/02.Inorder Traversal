

//https://www.geeksforgeeks.org/batch/dsa-at-your-own-pace/track/DSASP-Tree/problem/inorder-traversal

class Solution {
    public ArrayList<Integer> inOrder(Node root) {
        ArrayList<Integer> q=new ArrayList<>();
        if(root==null){
            return q;
        }
        q.addAll(inOrder(root.left));
        q.add(root.data);
        q.addAll(inOrder(root.right));
        
        return q;
    }
    
}
